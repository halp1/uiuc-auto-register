# Your Illinois login. Copy these from your uiuc-totp setup.
UIUC_NETID=
UIUC_PASSWORD=
UIUC_TOTP_SECRET=

# simulated (default, nothing real happens), test (real login, read only), or live (real registration)
REGISTRATION_MODE=simulated

# Optional
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=./data
# BROWSER_BACKEND=chrome
# BUN_CHROME_PATH=/path/to/chrome
